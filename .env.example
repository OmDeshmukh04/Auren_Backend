# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
PORT=5181
API_PUBLIC_URL=http://127.0.0.1:5181
PUBLIC_SITE_URL=http://127.0.0.1:5180
STAFF_APP_URL=http://127.0.0.1:5180/studio
APP_ORIGINS=http://127.0.0.1:5180,http://localhost:5180

# Local PostgreSQL started by `npm run dev` (no Docker). Point at Neon and remove LOCAL_POSTGRES to use a hosted database.
LOCAL_POSTGRES=true
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/auren_dev
DATABASE_SSL=false

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
SIGNING_SECRET=
CRON_SECRET=

# log = write emails to .data/mailbox; resend = real delivery (staging/production)
EMAIL_PROVIDER=log
EMAIL_FROM=Auren Households <no-reply@example.invalid>
# EMAIL_REPLY_TO=
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# Outside production, real email is sent only to these addresses or @domains:
# EMAIL_ALLOWLIST=you@example.com,@yourcompany.com

# local = .data/storage; s3 = private bucket (Cloudflare R2 or any S3-compatible store)
STORAGE_PROVIDER=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_PRIVATE_BUCKET=
# S3_PUBLIC_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# PUBLIC_MEDIA_BASE_URL=

# dev-allow (local only), clamd (ClamAV daemon) or none (uploads stay quarantined)
SCANNER_PROVIDER=dev-allow
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310

# Optional Cloudflare Turnstile for public forms
# TURNSTILE_SECRET_KEY=
LOG_LEVEL=info
